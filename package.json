{
  "name": "gcg-vue",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vp dev --host",
    "build": "vp build",
    "preview": "vp preview --host",
    "lint": "vp lint .",
    "lint:fix": "vp lint . --fix && vp fmt .",
    "format": "vp fmt .",
    "format:check": "vp fmt --check .",
    "scrape:products": "node scripts/scrape-products.mjs",
    "scrape:cards": "node scripts/scrape-cards.mjs",
    "scrape:tournament": "node scripts/scrape-tournaments.mjs",
    "scrape:bandai": "node scripts/scrape-tournaments-bandai-plus.mjs",
    "download:images": "node scripts/download-images.mjs",
    "build:tiers": "node scripts/build-tiers.mjs",
    "data": "node scripts/scrape-products.mjs && node scripts/scrape-cards.mjs && node scripts/scrape-tournaments.mjs && node scripts/build-tiers.mjs",
    "postinstall": "node scripts/generate.mjs"
  },
  "dependencies": {
    "@vueuse/core": "^15.0.0",
    "apexcharts": "^8.7.0",
    "clsx": "^2.1.1",
    "nprogress": "^0.2.0",
    "playwright-core": "^1.64.1",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.44",
    "vue-i18n": "^11.4.18",
    "vue-router": "^5.4.0",
    "vue3-apexcharts": "^1.11.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.10",
    "axios": "^1.21.0",
    "cheerio": "^1.2.0",
    "simple-statistics": "^8.0.0",
    "tailwindcss": "^4.3.3",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-vue-components": "^32.1.0",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plus": "1.4.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0"
  }
}
